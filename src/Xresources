
! Fonts
!
                           *fontList: -adobe-helvetica-bold-o-normal--14-*
                      *menu*fontList: -adobe-helvetica-bold-o-normal--14-*
                    *menubar*FontSet: -adobe-helvetica-bold-o-normal--14-*
                       Xft.antialias: true


! Clients
!
   Emwm*client*title*activeBackground: #c5c1aa
                          *iconImage: /home/ray/.config/pirix/icons/client.xpm
                Emwm*client*iconImage: /home/ray/.config/pirix/icons/client.xpm
                 Emwm*Emacs*iconImage: /home/ray/.config/pirix/icons/emacs.xpm
           Emwm*Firefox-esr*iconImage: /home/ray/.config/pirix/icons/firefox-esr.xpm
           Emwm*Mathematica*iconImage: /home/ray/.config/pirix/icons/mathematica.xpm
                 Emwm*NEdit*iconImage: /home/ray/.config/pirix/icons/nedit.xpm
                 Emwm*URxvt*iconImage: /home/ray/.config/pirix/icons/winterm.xpm
   Emwm*X-terminal-emulator*iconImage: /home/ray/.config/pirix/icons/winterm.xpm
        Emwm*Gnome-terminal*iconImage: /home/ray/.config/pirix/icons/winterm.xpm
            Emwm*Lxterminal*iconImage: /home/ray/.config/pirix/icons/winterm.xpm


! Appearance and Behaviour
!
                      Emwm*background: #aaaaaa
                      Emwm*foreground: gray10
                 Emwm*menu*foreground: gray10
                Emwm*activeBackground: #c5c1aa

                       Emwm*iconClick: false
                  Emwm*iconDecoration: label image
                Emwm*iconImageMaximum: 85x67
                   Emwm*iconPlacement: left top tight
             Emwm*iconPlacementMargin: 10
                  Emwm*lowerOnIconify: false
                      Emwm*useIconBox: false
		      
                  Emwm*buttonBindings: DefaultButtonBindings
                  Emwm*freezeOnConfig: false
                     Emwm*keyBindings: DefaultKeyBindings
             Emwm*keyboardFocusPolicy: explicit
                     Emwm*passButtons: true
                    Emwm*showFeedback: behavior restart quit
              Emwm*transientFunctions: all -minimize -quit

                Emwm*frameBorderWidth: 6
		     Emwm*limitResize: true
                      Emwm*moveOpaque: true
                   Emwm*moveThreshold: 3
                     Emwm*multiScreen: true
                 Emwm*positionIsFrame: false
                Emwm*positionOnScreen: true
               Emwm*resizeBorderWidth: 6
                    Emwm*resizeOpaque: true
                      Emwm*windowMenu: DefaultWindowMenu


! Strings
!
       Emwm*confirmQuit*messageString: Exit piDwm?
   Emwm*confirmQuit*cancelLabelString: Cancel
       Emwm*confirmQuit*okLabelString: OK
    Emwm*confirmRestart*messageString: Restart piDwm?
Emwm*confirmRestart*cancelLabelString: Cancel
    Emwm*confirmRestart*okLabelString: OK
!                    Emwm*iconBoxTitle: Windows Overview


! Emacs
!
! GNU Emacs needs Athena/Motif support built-in
!  (and possibly GTK built-out).
! Xemacs honours X resources.
! Emacs-lucid resources also work but names vary...
!
     Emacs.pane.menubar.*.fontList: -adobe-helvetica-bold-o-normal--14-*
           Emacs.pane.menubar.font: -adobe-helvetica-bold-o-normal--14-*


! NEdits
!
             nedit*text.background: #cc9999


! gr_osview
!
                     xosview*title: gr_osview
                  xosview*geometry: 300x400-10-10
                      xosview*font: -adobe-helvetica-bold-o-normal--10-*
                xosview*background: gray70
                xosview*foreground: gray10
           xosview*meterLabelColor: gray30
                xosview*usedlabels: False
            xosview*usedLabelColor: gray50
! LOAD
                      xosview*load: False
! CPU
                  xosview*cpuDecay: False
                  xosview*cpuGraph: False
               xosview*cpuPriority: 10
              xosview*cpuFreeColor: gray50
! MEM
              xosview*memFreeColor: gray50
! DISK
             xosview*diskIdleColor: gray50
! SWAP
             xosview*swapFreeColor: gray50
! PAGE
             xosview*pageIdleColor: gray50
! NET
             xosview*netBackground: gray50
! WLAN
                  xosview*wireless: false
! BTRY
                   xosview*battery: false
            xosview*btryBackground: gray40


