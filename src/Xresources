
! Fonts
!
                           *fontList: -adobe-helvetica-bold-o-normal--14-*
                      *menu*fontList: -adobe-helvetica-bold-o-normal--14-*
                    *menubar*FontSet: -adobe-helvetica-bold-o-normal--14-*
                       Xft.antialias: true


! Clients
!
   Mwm*client*title*activeBackground: #c5c1aa
                          *iconImage: /opt/pirix/icons/client.xpm
                Mwm*client*iconImage: /opt/pirix/icons/client.xpm
                 Mwm*Emacs*iconImage: /opt/pirix/icons/emacs.xpm
           Mwm*Firefox-esr*iconImage: /opt/pirix/icons/firefox-esr.xpm
           Mwm*Mathematica*iconImage: /opt/pirix/icons/mathematica.xpm
                 Mwm*NEdit*iconImage: /opt/pirix/icons/nedit.xpm
                 Mwm*URxvt*iconImage: /opt/pirix/icons/winterm.xpm
   Mwm*X-terminal-emulator*iconImage: /opt/pirix/icons/winterm.xpm
        Mwm*Gnome-terminal*iconImage: /opt/pirix/icons/winterm.xpm
            Mwm*Lxterminal*iconImage: /opt/pirix/icons/winterm.xpm


! Appearance and Behaviour
!
                      Mwm*background: #aaaaaa
                      Mwm*foreground: gray10
                 Mwm*menu*foreground: gray10
                Mwm*activeBackground: #c5c1aa

                       Mwm*iconClick: false
                  Mwm*iconDecoration: label image
                Mwm*iconImageMaximum: 85x67
                   Mwm*iconPlacement: left top tight
             Mwm*iconPlacementMargin: 10
                  Mwm*lowerOnIconify: false
                      Mwm*useIconBox: false
		      
                  Mwm*buttonBindings: ButtonBindings
                  Mwm*freezeOnConfig: false
                     Mwm*keyBindings: KeyBindings
             Mwm*keyboardFocusPolicy: explicit
                     Mwm*passButtons: true
                    Mwm*showFeedback: behavior restart quit
              Mwm*transientFunctions: all -minimize -quit

                Mwm*frameBorderWidth: 6
		     Mwm*limitResize: true
                      Mwm*moveOpaque: true
                   Mwm*moveThreshold: 3
                     Mwm*multiScreen: true
                 Mwm*positionIsFrame: false
                Mwm*positionOnScreen: true
               Mwm*resizeBorderWidth: 6
                    Mwm*resizeOpaque: true
!                      Mwm*windowMenu: WindowMenu


! Strings
!
       Mwm*confirmQuit*messageString: Exit piDwm?
   Mwm*confirmQuit*cancelLabelString: Cancel
       Mwm*confirmQuit*okLabelString: OK
    Mwm*confirmRestart*messageString: Restart piDwm?
Mwm*confirmRestart*cancelLabelString: Cancel
    Mwm*confirmRestart*okLabelString: OK
!                    Mwm*iconBoxTitle: Windows Overview


! Emacs
!
! GNU Emacs needs Athena/Motif support built-in
!  (and possibly GTK built-out).
! Xemacs honours X resources.
! Emacs-lucid resources also work but names vary...
!
     Emacs.pane.menubar.*.fontList: -adobe-helvetica-bold-o-normal--14-*
           Emacs.pane.menubar.font: -adobe-helvetica-bold-o-normal--14-*


! NEdit
!
             nedit*text.background: #cc9999


! gr_osview
!
                     xosview*title: gr_osview
                  xosview*geometry: 300x400-10-10
                      xosview*font: -adobe-helvetica-bold-o-normal--10-*
                xosview*background: gray70
                xosview*foreground: gray10
           xosview*meterLabelColor: gray30
                xosview*usedlabels: False
            xosview*usedLabelColor: gray50
! LOAD
                      xosview*load: False
! CPU
                  xosview*cpuDecay: False
                  xosview*cpuGraph: False
               xosview*cpuPriority: 10
              xosview*cpuFreeColor: gray50
! MEM
              xosview*memFreeColor: gray50
! DISK
             xosview*diskIdleColor: gray50
! SWAP
             xosview*swapFreeColor: gray50
! PAGE
             xosview*pageIdleColor: gray50
! NET
             xosview*netBackground: gray50
! WLAN
                  xosview*wireless: false
! BTRY
                   xosview*battery: false
            xosview*btryBackground: gray40


! winterm
!
            URxvt*font: -*-lucidatypewriter-medium-*-*-*-14-*-*-*-*-*-*-*
        URxvt*boldFont: -*-lucidatypewriter-bold-*-*-*-14-*-*-*-*-*-*-*
      URxvt*background: #00003f
      URxvt*foreground: gray90
     URxvt*scrollstyle: next
       URxvt*thickness: 14
 URxvt*scrollBar_right: false


! xclock
!
       XClock*geometry: -16+16
     XClock*background: #cccccc


! xconsole
!
     XConsole*geometry: 800x64+16-16
